  "components": [
    {
      "name": "Primary navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Select the main workbench destination in Blue.",
      "html": "<nav class=\"ds-primary-nav\" role=\"tablist\" aria-label=\"主要功能\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"work-panel\">工作台</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"knowledge-panel\">知识库</button></nav>",
      "css": ".ds-primary-nav{display:grid;gap:8px;padding:12px;background:var(--blue-nav);}.ds-primary-nav button{display:flex;align-items:center;min-height:46px;padding:10px 13px;border:0;border-radius:9px;background:transparent;color:var(--blue-nav-muted);font:400 14px/1.5 var(--font-body);text-align:left;transition:background-color var(--motion-fast),color var(--motion-fast);}.ds-primary-nav button:hover{background:var(--blue-nav-hover);color:var(--blue-nav-ink);}.ds-primary-nav button[aria-selected=true]{background:#2463df;color:#fff;}.ds-primary-nav button:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px;}"
    },
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Start a new conversation from the Work directory.",
      "html": "<button type=\"button\" class=\"ds-primary-action\">新会话</button>",
      "css": ".ds-primary-action{min-height:38px;padding:8px 12px;border:0;border-radius:8px;background:var(--accent-cta-bg);color:var(--accent-pure-cta-fg);font:550 12px/1.5 var(--font-body);text-align:left;transition:background-color var(--motion-fast);}.ds-primary-action:hover{background:var(--accent-hover);}.ds-primary-action:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;}.ds-primary-action:disabled{background:var(--surface-hover-soft);color:var(--muted-readable);}"
    },
    {
      "name": "Selected Work row",
      "kind": "card",
      "refersTo": "work-row-selected",
      "description": "Show the current Work in the resizable Blue directory.",
      "html": "<button type=\"button\" class=\"ds-work-row\" aria-current=\"page\"><span>lucyna</span></button>",
      "css": ".ds-work-row{display:flex;align-items:center;min-height:48px;padding:12px;border:0;border-radius:10px;background:transparent;color:var(--text-primary-body-strong);font:550 13px/1.55 var(--font-body);text-align:left;transition:background-color var(--motion-fast),color var(--motion-fast);}.ds-work-row:hover{background:var(--sidebar-hover);}.ds-work-row[aria-current=page]{background:var(--sidebar-selection);color:var(--accent-emphasis);}.ds-work-row:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px;}"
    },
    {
      "name": "Settings select",
      "kind": "input",
      "refersTo": "settings-select",
      "description": "Choose Light or Dark independently of the visual scheme.",
      "html": "<label class=\"ds-field-label\">明暗外观<select class=\"ds-field\" aria-label=\"明暗外观\"><option>浅色</option><option>深色</option></select></label>",
      "css": ".ds-field-label{display:grid;gap:7px;color:var(--text-primary);font:500 12px/1.5 var(--font-body);}.ds-field{min-height:36px;padding:6px 10px;border:1px solid var(--input-border);border-radius:8px;background:var(--surface);color:var(--text-primary);font:inherit;}.ds-field:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;}"
    },
    {
      "name": "Conversation composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Compose the next instruction at the foot of the conversation.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-composer-input\" aria-label=\"发送指令\" placeholder=\"交给 OMP 一个任务…\"></textarea><button type=\"button\" class=\"ds-send\" aria-label=\"发送\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7\"></path><path d=\"M12 19V5\"></path></svg></button></div>",
      "css": ".ds-composer{position:relative;padding:16px 18px 8px;border:1px solid var(--input-border);border-radius:13px;background:var(--surface-elevated);box-shadow:var(--composer-shadow);}.ds-composer:focus-within{outline:2px solid var(--focus-ring);outline-offset:3px;box-shadow:var(--composer-focus-shadow);}.ds-composer-input{display:block;width:100%;min-height:72px;max-height:200px;padding:0;border:0;resize:none;background:transparent;color:var(--text-primary);font:400 14px/1.7 var(--font-body);}.ds-composer-input:focus-visible{outline:none;}.ds-send{position:absolute;right:12px;bottom:10px;display:grid;place-items:center;width:36px;height:34px;border:0;border-radius:9px;background:var(--accent-cta-bg);color:var(--accent-pure-cta-fg);transition:background-color var(--motion-fast),transform var(--motion-fast);}.ds-send svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}.ds-send:hover{background:var(--accent-hover);}.ds-send:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px;}.ds-send:active{transform:scale(.92);}"
    },
    {
      "name": "Visual scheme choice",
      "kind": "card",
      "refersTo": "theme-choice-selected",
      "description": "Select Blue or Classic while keeping appearance mode independent.",
      "html": "<label class=\"ds-theme-choice\"><input type=\"radio\" name=\"visual-theme\" checked><span><strong>蓝调工作室</strong><small>深蓝导航 · 浅蓝目录 · 明亮阅读面</small></span></label>",
      "css": ".ds-theme-choice{display:flex;align-items:center;gap:10px;min-height:84px;padding:14px;border:1px solid var(--soft-border);border-radius:12px;background:var(--surface-elevated);color:var(--text-primary);font:400 12px/1.7 var(--font-body);transition:background-color var(--motion-fast),border-color var(--motion-fast);}.ds-theme-choice input{width:16px;height:16px;accent-color:var(--accent-cta-bg);}.ds-theme-choice strong{display:block;font-size:14px;font-weight:600;line-height:1.5;}.ds-theme-choice small{display:block;margin-top:4px;color:var(--muted-readable);}.ds-theme-choice:has(input:checked){border-color:var(--focus-ring);background:var(--surface-hover-soft);}.ds-theme-choice:focus-within{outline:2px solid var(--focus-ring);outline-offset:2px;}"
    },
    {
      "name": "Inspector segmented tabs",
      "kind": "chip",
      "refersTo": "inspector-tab-selected",
      "description": "Switch among Work context panels without changing the reading hierarchy.",
      "html": "<div class=\"ds-context-tabs\"><button type=\"button\" aria-pressed=\"true\">进展</button><button type=\"button\" aria-pressed=\"false\">资产</button></div>",
      "css": ".ds-context-tabs{display:flex;gap:4px;padding:4px;border-radius:8px;background:var(--sidebar-selection);}.ds-context-tabs button{flex:1;min-width:0;padding:6px 8px;border:0;border-radius:6px;background:transparent;color:var(--muted-readable);font:400 12px/1.5 var(--font-body);white-space:nowrap;transition:background-color var(--motion-fast),color var(--motion-fast);}.ds-context-tabs button:hover{color:var(--text-primary);}.ds-context-tabs button[aria-pressed=true]{background:var(--surface-elevated);color:var(--accent-emphasis);}.ds-context-tabs button:focus-visible{outline:2px solid var(--focus-ring);outline-offset:1px;}"
    }
  ],
  "narrative": {
    "northStar": "The Blue Local Workbench",
