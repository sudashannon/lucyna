{
  "name": "lucyna",
  "productName": "Lucyna",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "katex": "0.19.1"
  },
  "description": "Lucyna — a Windows desktop workbench for native OMP, WSL workspaces and Stele knowledge",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "prestart": "node tools/build-renderer.cjs",
    "dev": "vite",
    "build": "node tools/build-renderer.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./test/setup.cjs --test test/*.test.cjs",
    "test:renderer": "electron test/screenshot-gallery.cjs --check",
    "test:chrome": "electron test/window-chrome-desktop.cjs",
    "test:taskbar": "electron test/taskbar-desktop.cjs",
    "test:drafts": "electron test/drafts-desktop.cjs",
    "test:single-instance": "electron test/single-instance-desktop.cjs",
    "test:experience": "electron test/experience-desktop.cjs",
    "test:usability": "electron test/usability-desktop.cjs",
    "test:work:ui": "electron test/work-details-ui.cjs",
    "test:history:native": "electron test/history-native-desktop.cjs",
    "test:knowledge:native": "electron test/knowledge-native-desktop.cjs",
    "preview:knowledge": "electron test/knowledge-native-desktop.cjs --live-read --preview",
    "test:pet:animation": "electron test/pet-animation-desktop.cjs",
    "test:feedback": "electron test/feedback-desktop.cjs",
    "test:auxiliary": "electron test/auxiliary-desktop.cjs",
    "test:auxiliary:native": "node test/auxiliary-native.cjs",
    "test:typography": "electron test/brand-typography-desktop.cjs",
    "test:attachments": "electron test/text-attachments-desktop.cjs",
    "test:attachments:native": "node test/text-attachments-native.cjs",
    "test:sessions": "electron test/session-monitor-desktop.cjs",
    "test:sessions:restore": "node test/session-restore-desktop.cjs",
    "test:knowledge:sidebar": "electron test/knowledge-sidebar-desktop.cjs",
    "test:pet:layout": "electron test/pet-layout-desktop.cjs",
    "screenshots": "electron test/screenshot-gallery.cjs",
    "test:pet:recovery": "electron test/pet-recovery-desktop.cjs",
    "pet:preview": "electron tools/show-pet-animation.cjs",
    "icons:build": "electron tools/build-app-icons.cjs",
    "start:legacy": "node tools/launch-legacy.cjs"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "electron": "45.0.0",
    "postcss": "8.5.6",
    "puppeteer-core": "24.31.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.4.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.105",
    "@ai-sdk/openai-compatible": "3.0.81",
    "@fontsource-variable/inter": "5.2.8",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tooltip": "1.2.8",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.157",
    "clsx": "2.1.1",
    "cytoscape": "3.34.4",
    "i18next": "25.6.3",
    "katex": "0.19.1",
    "lucide-react": "0.468.0",
    "node-pty": "1.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "16.3.5",
    "streamdown": "2.7.1",
    "tailwind-merge": "2.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sudashannon/lucyna.git"
  },
  "homepage": "https://github.com/sudashannon/lucyna#readme",
  "bugs": {
    "url": "https://github.com/sudashannon/lucyna/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
